<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/>
    </startup>
    <appSettings>
        <!--Motion Server IP: the default is localhost; you can change it to 0.0.0.0 (all interfaces) or a specific LAN IP
        which is **useful if you want to access the server from another computer in a network.** Default: 127.0.0.1-->
        <add key="IP" value="127.0.0.1" />
        <!--Motion Server port: the default is 26760; if it conflicts with another server set it to anything valid
        but in that case also change the port in PadTest and cemuhook.ini accordingly. Default: 26760 -->
        <add key="Port" value="26760" />
        <!-- Start minimized to the system tray instead of showing the main window. -->
        <!-- Default: false -->
        <add key="StartInTray" value="true" />
        <!-- Hide the status log box on the main window. -->
        <!-- Default: false -->
        <add key="HideStatus" value="true" />
        <!--Whether the Motion Server is enabled or not. Default: true -->
        <add key="MotionServer" value="false" />

        <!--The controller's HD rumble settings for the low/high frequency rumble. Change to change the pitch of the rumble.-->
        <!--Don't set above ~1200. Default: 40 and 120 -->
        <!--To have "stronger" rumble, try setting the low/high to 160/320-->
        <add key="LowFreqRumble" value="40" />
        <add key="HighFreqRumble" value="120" />
        <!--Rumble Setting. Turns rumble on or off.-->
        <!--On is "true"; off is "false". Default: true -->
        <add key="EnableRumble" value="true" />

        <!--Enables a input when shaking a controller, only works with DS4 for now, replaces the touchpad input (Button 13 on DirectInput)-->
        <!--On is "true"; off is "false". Default: false -->
        <add key="EnableShakeInput" value="false" />
        <!--How sensitve the shake detection should be. Default: 10-->
        <add key="ShakeInputSensitivity" value="10" />
        <!--How often should the shake input run in milliseconds. -->
        <!--Don't set this lower than 15 -->
        <!-- Default: 200 -->
        <add key="ShakeInputDelay" value="200" />

        <!--Swap A-B buttons; if on, this mimicks the (half of) Xbox layout by the button name, rather than by the physical layout.-->
        <!--Also swaps buttons when using "Also use for buttons/axes"-->
        <!--On is "true"; off is "false". Default: false -->
        <add key="SwapAB" value="false" />
        <!--Swap X-Y buttons; if on, this mimicks the (other half of) Xbox layout by the button name, rather than by the physical layout.-->
        <!--Also swaps buttons when using "Also use for buttons/axes"-->
        <!--On is "true"; off is "false". Default: false -->
        <add key="SwapXY" value="false" />

        <!-- Allows for calibration of the controller's gyro, accel and axes-->
        <!-- When "true", double click a controller to calibrate-->
        <!-- Default: false -->
        <add key="AllowCalibration" value="true" />
        <!-- Allows to emulate the n64 range of joystick (.8, .8) instead of real xbox360 (1, 1). -->
        <add key="N64Range" value="false" />
        <!-- Default calibration; used for third party controller -->
        <add key="acc_sensiti" value="16384,16384,16384"/>
        <add key="gyr_sensiti" value="18500,18500,18500"/>
        <add key="stick_cal" value="0x780,0x780,0x780,0x830,0x780,0x780"/>
        <add key="deadzone" value="50"/>
        <add key="stick2_cal" value="0x780,0x780,0x780,0x830,0x780,0x780"/>
        <add key="deadzone2" value="50"/>

        <!-- Scales the xy coordinates each of the joysticks report. Increase this if you can't push the stick to its maximum. -->
        <add key="StickScalingFactor" value="1.00" />
        <add key="StickScalingFactor2" value="1.00" />

        <!-- Allows use of gyroscope tilting to get full control of the slider values (big triggers)-->
        <!-- Works on pro controller and joined joycons (pro controller case - triggers combined, joycons case - separate tilt)-->
        <!-- Default: false -->
        <add key="GyroAnalogSliders" value="false" />
        <!-- Change to -400 to change direction of tilt needed. Positive is ramp up if pointing up-->
        <!-- Default: 400 -->
        <add key="GyroAnalogSensitivity" value="500" />

        <!-- Determines whether or not to use HidHide (improves compatibility with other programs, like Steam, when set to "true") -->
        <!-- When "true", BetterJoy hides the Pro/Joycons from other programs entirely (they won't even enumerate the device), -->
        <!-- which avoids DI/XI clashes and conflicts that can occur the moment another program starts, regardless of that -->
        <!-- program's own "ignore this controller" settings. Requires the HidHide driver to be installed. -->
        <!-- Default: false (a brand-new install defaults this to true instead if the HidHide driver is already present - see -->
        <!-- EntryPoint.DefaultHidHideToInstalledState - this value only applies when the driver isn't installed yet) -->
        <add key="UseHidHide" value="true" />

        <!-- Remove controllers from HidHide's block list on a clean exit, so other programs can -->
        <!-- see them again once BetterJoy closes. Turn off to leave them hidden across restarts - -->
        <!-- useful if another program should never see them regardless of whether BetterJoy is running. -->
        <!-- should be false when running as a servivce -->
        <!-- Default: true -->
        <add key="UnhideOnExit" value="false" />

        <!-- Periodically scan for newly connected controllers while the app is running. -->
        <!-- Default: true -->
        <add key="PassiveScan" value="true" />

        <!-- Automatically register newly detected 3rd-party HID gamepads/joysticks (that aren't already known) as controllers, -->
        <!-- guessing Pro/Left Joycon/Right Joycon from the device name, instead of requiring manual setup via "Add Controllers". -->
        <!-- Only works for devices that actually speak the Nintendo controller protocol underneath (e.g. licensed Pro Controller clones). -->
        <!-- Default: true -->
        <add key="AutoAddControllers" value="true" />

        <!-- Never auto-add a 3rd-party controller connected over USB (some controllers identify differently per transport - -->
        <!-- e.g. show up as a distinct device over USB vs Bluetooth - blacklisting one identity from the Add Controllers -->
        <!-- dialog is usually more precise, but this blocks USB entirely regardless of which device it is). -->
        <!-- Default: false -->
        <add key="BlockAutoAddUSB" value="true" />

        <!-- Never auto-add a 3rd-party controller connected over Bluetooth. See BlockAutoAddUSB above. -->
        <!-- Default: false -->
        <add key="BlockAutoAddBluetooth" value="false" />

        <!-- The program will keep the HOME button LED ring light on at all times. -->
        <!-- Default: true -->
        <add key="HomeLEDOn" value="true"/>
        <!-- Will use multiple lights to display the current player rather than a single LED-->
        <add key="UseIncrementalLights" value="true" />

        <!-- Determines whether or not to translate gyro movements into joystick ("joy") or mouse movement ("mouse"), or have no effect ("none") -->
        <!-- When "joy_left" or "joy_right", turn gyro movements into respective left/right joystick (mouse-like) movements -->
        <!-- When "mouse", turn gyro movements into mouse movement. Press either stick-button to reset to middle of primary display  -->
        <!-- Default: none -->
        <!-- Legacy migration hint only. New profiles independently map gyro mouse, left stick, -->
        <!-- and right stick; this key is hidden from Settings and is not used at runtime. -->
        <add key="GyroToJoyOrMouse" value="mouse"/>
        <!-- Whether gyro-mouse/gyro-stick uses filtered IMU or raw gyro values. Filtered mode
        shares a guarded accelerometer gravity reference for world-space yaw/pitch alignment.
        Only gyro rate creates mouse or stick movement; acceleration cannot directly steer it.
        Gyro-mouse additionally applies smoothing and stationary-bias learning. Raw mode bypasses
        gravity alignment and retains the legacy feature-specific axis mappings. -->
        <!-- Default: true -->
        <add key="UseFilteredIMU" value="true"/>
        <!-- Beta value of AHRS (Madgwick filter gain) - trades lag for noise. Lower trusts gyro -->
        <!-- integration more and corrects toward true orientation slower (more lag). Higher -->
        <!-- corrects faster but lets more accelerometer noise (hand jitter, not just gravity) -->
        <!-- through. This affects AHRS-based analog sliders and diagnostic orientation only; -->
        <!-- filtered gyro-mouse and gyro-stick use separately guarded shared gravity fusion. -->
        <!-- Default: 0.1 -->
        <add key="AHRS_beta" value="1"/>
        <!-- Sensitivity of gyro-to-mouse movements - the same value now applies whether -->
        <!-- UseFilteredIMU is true or false; raw mode used to need manually dividing this by -->
        <!-- ~15 to compensate for a degrees/radians unit mismatch between the two paths, now -->
        <!-- fixed in code (see Joycon.ProcessGyroMouseSample). -->
        <!-- Defaults put roughly one 1920x1080 screen of travel in 21.5 degrees of controller -->
        <!-- rotation, avoiding the awkward large tilt/turn range of the previous defaults. -->
        <!-- Default: 2400; 1400 -->
        <add key="GyroMouseSensitivityX" value="2400"/>
        <add key="GyroMouseSensitivityY" value="1400"/>
        <!-- Approximate controller rotation, in degrees, required to move across one screen. -->
        <!-- Lower values make the pointer faster and require less hand movement; higher values -->
        <!-- make it slower and require more. This scales X and Y together while preserving the -->
        <!-- GyroMouseSensitivityX/Y balance. With GyroMouseDirectCursor=false, Windows or a game -->
        <!-- may additionally scale relative mouse input. Default: 45.0 (the behavior above). -->
        <add key="GyroMouseScreenTraversalDegrees" value="21.5"/>
        <!-- World-space rates use an adaptive 2D exponential filter. The time value controls -->
        <!-- low-speed smoothing; filtering blends away between half and all of the angular-speed -->
        <!-- threshold so ordinary pointer sweeps remain smooth and fast turns remain responsive. -->
        <!-- Set either value to 0 to disable. Defaults: 18 ms; 120 degrees/sec. -->
        <add key="GyroMouseSmoothingTimeMs" value="8"/>
        <add key="GyroMouseSmoothingThreshold" value="10"/>
        <!-- Soft low-speed stabilization adapted from JoyShockLibrary's reference mouse sample. -->
        <!-- Below this angular speed (degrees/sec), gyro gain ramps smoothly from zero to full. -->
        <!-- Unlike a deadzone it preserves fine motion, and it adds no filtering delay. Set 0 to -->
        <!-- disable. Default: 2.0 -->
        <add key="GyroMouseTighteningThreshold" value="10"/>
        <!-- Affects both filtered and raw gyro-mouse. Filtered mode uses world-space mapping: -->
        <!-- fused gravity aligns yaw and pitch to the player, while measured gyro -->
        <!-- rate remains the sole movement source. Raw mode uses gyro-only orientation mapping. -->
        <!-- Set false only to compare with direct local-Y/Z rate mapping. -->
        <!-- Default: true -->
        <add key="GyroMouseRollCompensation" value="true"/>
        <!-- Point-and-click mode: place the cursor by exact pixel deltas instead of submitting -->
        <!-- relative mouse input for Windows to rescale with pointer speed/acceleration. This -->
        <!-- preserves a closed gyro path all the way through to the visible cursor. Set false -->
        <!-- for games that specifically require relative mouse input. -->
        <!-- Default: true -->
        <add key="GyroMouseDirectCursor" value="true"/>
        <!-- When exact point-and-click gyro cursor mode reaches an edge of the monitor that -->
        <!-- currently contains the pointer, continue from the opposite edge. This restores -->
        <!-- unlimited gyro travel without affecting ordinary relative mouse/game input. It is -->
        <!-- ignored when GyroMouseDirectCursor=false. Default: true -->
        <add key="GyroMouseScreenWrap" value="false"/>
        <!-- Prefer the optional FakerInput virtual HID mouse when its driver is installed. This -->
        <!-- lets controller mouse input reach elevated applications, UAC, and the Windows login -->
        <!-- screen when BetterJoy runs as a service. If absent/unavailable, logged-in sessions -->
        <!-- keep using the existing Windows input path; pre-login mouse output requires the -->
        <!-- driver. Set false to force fallback even when FakerInput is installed. Default: true -->
        <add key="UseFakerInput" value="true"/>
        <!-- For investigating issues with gyro mouse input - writes to -->
        <!-- gyro_mouse_debug.log in this app's data folder while gyro-mouse is active. Off by -->
        <!-- default: the logging itself (file I/O roughly every 150ms) is its own source of -->
        <!-- timing interference. Only turn on while deliberately capturing a test. -->
        <!-- Default: false -->
        <add key="GyroMouseDebugLogging" value="false"/>
        <!-- TEMPORARY gyro-to-joystick capture. While gyro is active, writes one CSV row per -->
        <!-- controller report to gyro_stick_debug.csv in this app's data folder. It records the -->
        <!-- applied output beside the AHRS/Euler diagnostic comparator and all three calibrated -->
        <!-- angular-rate samples so timing, axis selection, acceleration contamination, and -->
        <!-- stick shaping remain distinguishable. Diagnostic only; logging changes no output. -->
        <!-- Default: false -->
        <add key="GyroStickDebugLogging" value="true"/>
        <!-- Sensitivity of gyro-to-joystick movements -->
        <!-- Default: 40.0; 10.0 (if using raw values, decrease by a factor of ~15: eg 2.6, 0.6) -->
        <add key="GyroStickSensitivityX" value="100"/>
        <add key="GyroStickSensitivityY" value="85"/>
        <!-- Stick range reduction when gyro-to-joystick is enabled and active; divides the -->
        <!-- physical-stick input by this factor. 1 is unchanged; values above 1 reduce it. -->
        <!-- Zero, negative, NaN, and infinity safely behave as 1 (no reduction). -->
        <!-- Default: 1.5 -->
        <add key="GyroStickReduction" value="1"/>
        <!-- Gyro Hold/Toggle activation; true will require the mapped button to be continuously held down to keep gyro active -->
        <!-- Default: true [hold], false [toggle] -->
        <add key="GyroHoldToggle" value="false"/>
        <!-- When two joycons are connected, it would take the gyro movement of the right joycon for mouse movement. This swaps that -->
        <!-- Default: false -->
        <add key="GyroMouseLeftHanded" value="false"/>
        <!-- Changes drag behaviour. -->
        <!-- Will only apply to mouse buttons being mapped -->
        <!-- Default: false -->
        <add key="DragToggle" value="false"/>

        <!-- Bindable controller buttons for gyro-mouse actions, ONLY while gyro-mouse -->
        <!-- is actually active (see the profile's Activate Gyro to Mouse mapping) - meant for using the -->
        <!-- controller as a mouse substitute, so these are inert the rest of the time rather than -->
        <!-- stealing a button from its normal game mapping. Bind via Controller Profiles; value is -->
        <!-- "joy_N" (a Joycon.Button index), a "+"-joined combo of several, or "0" for unbound - -->
        <!-- see Joycon.ProcessGyroMouseSample/SimulateGyroMouseButton/SimulateGyroMouseScroll. -->
        <!-- Clench Gyro suppresses pointer motion while held, allowing the controller to be -->
        <!-- repositioned without moving the cursor. Default: 0 (unbound) for all six. -->
        <add key="left_click" value="joy_11"/>
        <add key="right_click" value="joy_12"/>
        <add key="center_click" value="0"/>
        <add key="scroll_up" value="0"/>
        <add key="scroll_down" value="0"/>
        <add key="clench_gyro" value="joy_1"/>

        <!-- Determines whether or not the program will expose detected controllers as Xbox controllers -->
        <!-- When "false", BetterJoy is only usable with programs that support UDPServer. -->
        <!-- Default: true -->
        <add key="ShowAsXInput" value="true" />
        <!-- Have ShowAsXInput as false if using this -->
        <!-- Default: false -->
        <add key="ShowAsDS4" value="false"/>

        <!-- Automatically power off controllers at program exit -->
        <!-- Default: false -->
        <add key="AutoPowerOff" value="true" />
        <!-- Automatically power off controllers after a period of inactivity (in minutes) -->
        <!-- Default: 30 (-1 indicates infinite time) -->
        <add key="PowerOffInactivity" value="5" />
        <!-- Power off controllers when Capture (left only) or Home (right only or combined) buttons are pressed for a long interval (2s) -->
        <!-- Default: true -->
        <add key="HomeLongPowerOff" value="true" />

        <!-- Double click sticks on joycons (L3, R3) to change joycon orientation -->
        <!-- Default: true -->
        <add key="ChangeOrientationDoubleClick" value="false" />
        <!-- Do not rejoin joycons once split via clicking on their icon -->
        <!-- When 'true' allows you to double-click the joycons to split them and then change their orientation to vertical -->
        <!-- Default: false -->
        <add key="DoNotRejoinJoycons" value="false" />

        <!-- Determines what type of debugging information to be printed -->
        <!-- None = 0 -->
        <!-- All = 1 -->
        <!-- Comms = 2 -->
        <!-- Threading = 3 -->
        <!-- IMU = 4 -->
        <!-- Rumble = 5 -->
        <!-- Shake Input = 6 -->
        <!-- Default: 0 -->
        <add key="DebugType" value="0" />
    </appSettings>
</configuration>
